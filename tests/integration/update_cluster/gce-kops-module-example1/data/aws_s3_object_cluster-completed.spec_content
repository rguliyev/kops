    - instanceGroup: control-plane-us-west1-b
      name: b
    - instanceGroup: control-plane-us-west1-c
      name: c
    manager:
      backupRetentionDays: 90
    memoryRequest: 100Mi
    name: main
    version: 3.6.11
  - backups:
